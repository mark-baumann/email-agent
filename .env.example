OPENAI_API_KEY=your_openai_api_key
# IMAP assistant model provider: openai or ollama_cloud
MODEL_PROVIDER=openai
OPENAI_MODEL=gpt-4.1
# Direct Ollama Cloud access; no local Ollama installation required
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_MODEL=gpt-oss:120b
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT="interrupt-workshop"

# IMAP/SMTP account (e.g. one.com) for the email_assistant_hitl_memory_imap graph
EMAIL_ADDRESS=you@yourdomain.com
EMAIL_PASSWORD=your_mailbox_password
# Defaults below are for one.com — override for other providers
IMAP_HOST=imap.one.com
IMAP_PORT=993
SMTP_HOST=send.one.com
SMTP_PORT=465
# Set to true to use STARTTLS (typically with SMTP_PORT=587) instead of SSL
SMTP_STARTTLS=false
# Mailbox folders (defaults shown)
IMAP_MAILBOX=INBOX
IMAP_SENT_MAILBOX=Sent

# Inbox UI. For deployment under a domain add it to INBOX_ALLOWED_HOSTS,
# e.g. email-agent.markb.de; see deploy/windows/README.md or deploy/pi/README.md.
INBOX_ALLOWED_HOSTS=127.0.0.1,localhost
INBOX_AGENT_URL=http://127.0.0.1:2024
INBOX_PORT=8080
# Optional: persistent import/settings database location
# INBOX_DATABASE=/var/lib/email-agent/inbox.sqlite3
# Studio on the Pi: use an SSH tunnel to port 2024; see deploy/pi/README.md
# INBOX_STUDIO_URL=https://smith.langchain.com/studio/?baseUrl=http://127.0.0.1:2024
