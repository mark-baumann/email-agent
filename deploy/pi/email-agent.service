[Unit]
Description=Email assistant LangGraph server (personal development runtime)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/email-agent
Environment=PYTHONUTF8=1
ExecStart=%h/email-agent/.venv/bin/langgraph dev --config langgraph.imap.json --no-browser --no-reload --host 127.0.0.1 --port 2024
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
